@model EmployeeResponse

<h1>Delete Employee</h1>

<div class="alert alert-danger">
    <p>Are you sure you want to delete this employee?</p>
</div>

<div class="employee-details">
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Salary:</strong> @Model.Salary</p>
    <p><strong>Joining Date:</strong> @Model.JoiningDate?.ToString("d")</p>
    <p><strong>Department:</strong> @Model.DepartmentName</p>
</div>

<form method="post" action="@Url.Action("Delete", "Employee", new { employeeId = Model.EmployeeId })">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="@Url.Action("Index", "Employee")" class="btn btn-secondary">Cancel</a>
</form>
