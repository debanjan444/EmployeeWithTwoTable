

@model List<EmployeeResponse>
<h1>Employee List</h1>

<a href="@Url.Action("Create", "Employee")" class="btn btn-primary mb-3">Add New Employee</a>

@if (Model != null && Model.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Salary</th>
                <th>Joining Date</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Name</td>
                    <td>@employee.Email</td>
                    <td>@employee.Salary</td>
                    <td>@employee.JoiningDate?.ToString("d")</td>
                    <td>@employee.DepartmentName</td>
                    <td>
                        <a href="@Url.Action("Edit", "Employee", new { employeeId = employee.EmployeeId })" class="btn btn-warning btn-sm">Edit</a>
                        <a href="@Url.Action("Delete", "Employee", new { employeeId = employee.EmployeeId })" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No employees found.</p>
}
